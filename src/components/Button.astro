---
// reusable button: href is the link and theme is the colour style
const { href, theme = "primary" } = Astro.props;
// becomes a link if it has an href, otherwise a button
const El = href ? "a" : "button";
---

<El class="button" {href} data-type={theme}>
  <slot />
</El>

<style lang="scss">
  @use "../styles/abstracts" as *;

  // styles shared by every button
  .button {
    display: inline-flex;
    justify-content: center;
    cursor: pointer;
    text-decoration: none;
    line-height: 1;
    font-family: $button-font-family;
    font-size: $button-font-size;
    text-transform: $button-text-transform;
    font-weight: $button-font-weight;
    padding: $button-padding;
    border: $button-border;
    border-radius: $button-border-radius;
    transition: 275ms ease;

    // solid main colour
    &[data-type="primary"] {
      background-color: $button-primary-background;
      color: $button-primary-color;

      &:is(:hover, :focus) {
        background-color: $button-primary-background-hover;
        color: $button-primary-color-hover;
      }
    }

    // solid accent colour
    &[data-type="accent"] {
      background-color: $button-accent-background;
      color: $button-accent-color;

      &:is(:hover, :focus) {
        background-color: $button-accent-background-hover;
        color: $button-accent-color-hover;
      }
    }

    // transparent with an outline
    &[data-type="outline"] {
      background-color: $transparent-button-background-color;
      outline: $transparent-button-outline;
      outline-offset: $transparent-button-outline-offset;
      color: $transparent-button-color;

      &:is(:hover, :focus) {
        background-color: $transparent-button-background-hover;
        color: $transparent-button-color-hover;
        outline: $transparent-button-background-hover;
      }
    }
  }
</style>
