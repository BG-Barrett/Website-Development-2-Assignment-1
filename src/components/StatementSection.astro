<!-- short statement about the site and its data, with a link to About -->
<section class="statement section">
  <div class="statement__inner container">
    <p class="statement__text">
      Every animal that reaches us has a story worth following. Our records let
      you browse the animals in our care, add new arrivals, remove those
      released and search by species or status.
    </p>
    <a class="statement__link fw-bold" href="/about">
      About us
    </a>
  </div>
</section>

<style lang="scss">
  @use "../styles/abstracts" as *;
  .statement {
    background-color: $statement-background-color;

    // on medium screens and up, the content sits in the second column
    &__inner {
      display: grid;
      gap: $size-10;

      @include mq(medium) {
        grid-template-columns: 1fr 1fr;

        > * {
          grid-column: 2;
        }
      }
    }

    &__text {
      font-size: $font-size-700;
      font-weight: $font-weight-semi-bold;
      line-height: 1.3;
    }

    &__link {
      justify-self: end; // pushes it to the right edge of the column
      text-transform: uppercase;
      letter-spacing: 0.05em; // uppercase text looks better slightly spaced
      text-underline-offset: 0.4em; // moves the underline down, like the example
      color: $statement-link-color;

      &:is(:hover, :focus) {
        color: $statement-link-color-hover;
      }
    }
  }
</style>
