---
// large banner at the top of the home page
import Button from "../components/Button.astro";
---

<section class="hero">
  <!-- decorative background image, so the alt is empty -->
  <img
    class="hero__image"
    src="/images/kikatani-elephant-111695_1920.jpg"
    alt=""
  />
  <div class="hero__content container flow">
    <h1 class="hero__heading">Wild Welfare</h1>
    <p>
      Wildlife protection and conservation is one of the greatest things we
      offer our planet.
    </p>
    <!-- links to the other two pages -->
    <div class="hero__buttons flex-group mx-auto">
      <Button href="/animals" theme="primary">
        Animals
      </Button>
      <Button href="/about" theme="outline">
        About
      </Button>
    </div>
  </div>
</section>

<style lang="scss">
  @use "../styles/abstracts" as *;

  .hero {
    background-color: $hero-background-color;
    min-height: 100svh;

    display: grid;
    text-align: center;

    // places the image and content in the same grid cell so they overlap
    > * {
      grid-area: 1/1;
    }

    // dims the image so the text is easier to read
    &__image {
      opacity: 0.4;
      width: 100%;
      height: 0;
      min-height: 100%;
      object-fit: cover;
    }

    // centres the content and keeps it above the image
    &__content {
      font-size: $hero-content-font-size;
      color: $hero-text-color;
      padding-block: $hero-padding-block;
      align-self: center;
      z-index: 1;
    }

    &__heading {
      @include heading($hero-heading-font-size, $hero-heading-color);
    }

    &__buttons {
      justify-content: center;
    }
  }
</style>
