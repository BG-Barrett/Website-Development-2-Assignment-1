---
// image gallery, using the images listed in data/work.ts
import { work } from "../data/work";

interface Props {
  limit?: number;
}

// shows 7 images unless a different limit is passed in
const { limit = 7 } = Astro.props;
// takes the images from the start of the list
const items = work.slice(0, limit);
---

<!-- creates a list item for each image -->
<ul class="work__grid" role="list">
  {items.map((item) => (
    <li class="work__item">
      <img class="work__image" src={item.src} alt={item.alt} />
      <p class="work__title visually-hidden">{item.title}</p>
    </li>
  ))}
</ul>

<style lang="scss">
  @use "../styles/abstracts/" as *;

  .work {
    // 2 columns on small screens and 4 on medium screens and up
    &__grid {
      display: grid;
      gap: $grid-gap;
      grid-template-columns: repeat(2, 1fr);
      list-style: none;

      @include mq(medium) {
        grid-template-columns: repeat(4, 1fr);
      }
    }

    &__image {
      width: 100%;
      aspect-ratio: 2 / 1;
      object-fit: cover;
      transition: transform 400ms ease;
    }

    &__item {
      overflow: hidden;
    }

    // makes the second image twice as tall
    &__item:nth-child(2) {
      grid-row: span 2;
      position: relative;
    }

    &__item:nth-child(2) &__image {
      position: absolute;
      inset: 0;
      height: 100%;
      aspect-ratio: auto;
    }

    // zooms the image slightly on hover
    &__item:hover &__image {
      transform: scale(1.05);
    }
    @media (prefers-reduced-motion: no-preference) {
      &__image {
        transition: transform 400ms ease;
      }
    }
  }
</style>
