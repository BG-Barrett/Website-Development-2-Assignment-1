---
// reusable form: the fields it shows are chosen when it is used
import Button from "../components/Button.astro";

// every field the form can show
const allFields = {
  name: {
    label: "Name",
    name: "name",
    type: "text",
    autocomplete: "name",
    placeholder: "John Doe",
    required: true,
  },
  email: {
    label: "Email",
    name: "email",
    type: "email",
    autocomplete: "email",
    placeholder: "john.doe@example.com",
    required: true,
  },
  website: {
    label: "Website",
    name: "website",
    type: "url",
    autocomplete: "url",
    placeholder: "https://example.com",
    required: true,
  },
  phone: {
    label: "Phone",
    name: "phone",
    type: "tel",
    autocomplete: "tel",
    placeholder: "083 123 4567",
    required: false,
  },
} as const;

// the values this component accepts
interface Props {
  show?: (keyof typeof allFields)[];
  buttonText?: string;
  idPrefix?: string;
}

// reads the values passed in, with defaults if none are given
const {
  show = ["name", "email", "website", "phone"],
  buttonText = "Submit",
  idPrefix = "form",
} = Astro.props;
---

<!-- creates a label and input for each field in show -->
<form class="form" action="" method="POST">
  {show.map((fieldName) => {
    const field = allFields[fieldName];
    if (!field) return null;
    return (
      <div class="form__field">
        <label for={`${idPrefix}-${field.name}`}>
          {field.label}
          {field.required && <span class="form__required">(required)</span>}
        </label>
        <input
          type={field.type}
          name={field.name}
          id={`${idPrefix}-${field.name}`}
          autocomplete={field.autocomplete}
          placeholder={field.placeholder}
          required={field.required}
        />
      </div>
    );
  })}
  <Button theme="primary">{buttonText}</Button>
</form>

<script>
  // stops the page changing and thanks the user
  const signupForm = document.querySelector<HTMLFormElement>(".form");
  const signupButton = signupForm?.querySelector("button");

  signupForm?.addEventListener("submit", (event) => {
    event.preventDefault();
    signupForm.reset();
    if (signupButton) {
      signupButton.textContent = "Thanks for signing up!";
    }
  });
</script>

<style lang="scss">
  @use "../styles/abstracts/" as *;

  // one column on small screens and two on medium screens and up
  .form {
    display: grid;
    gap: $grid-gap;
    text-align: start;

    @include mq(medium) {
      grid-template-columns: repeat(2, 1fr);
    }

    // keeps each label directly above its input
    &__field {
      display: grid;
      gap: $form-group-spacing;
    }

    label {
      color: $form-label-color;
      font-family: $form-label-font-family;
      font-weight: $form-label-font-weight;
      font-size: $form-label-font-size;
    }

    &__required {
      font-size: $font-size-300;
      font-weight: $font-weight-default;
    }

    // input styles, using the form tokens
    input {
      width: 100%;
      color: $form-input-color;
      font-family: $form-input-font-family;
      font-weight: $form-input-font-weight;
      font-size: $form-input-font-size;
      background-color: $form-input-background-color;
      border: $form-input-border-default;
      border-radius: $form-input-border-radius;
      padding: $form-input-padding;

      // changes the border when a field is selected
      &:focus {
        border: $form-input-border-focus;
      }

      // placeholder text style
      &::placeholder {
        color: $form-placeholder-color;
        font-family: $form-placeholder-font-family;
        font-weight: $form-placeholder-font-weight;
        font-size: $form-placeholder-font-size;
      }
    }

    // the submit button spans both columns
    :global(.button) {
      grid-column: 1 / -1;
    }
  }
</style>
