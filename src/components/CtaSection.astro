---
// sign-up section on the home page
import CtaPanel from "../components/CtaPanel.astro";
---

<section class="cta section">
  <div class="cta__content container text-center">
    <h2 class="heading-2 padding-block-end-10">Find out how you can help</h2>
    <p class="fs-500 padding-block-end-10">
      Sign up to our email list for more information on our current projects.
    </p>
    <!-- image and form, showing only the name and email fields -->
    <CtaPanel
      theme="primary"
      src="/images/lenzleberkern-sea-4501052_1920.jpg"
      alt="A smiling man swimming face to face with a dolphin."
      show={["name", "email"]}
      buttonText="More Info"
    />
  </div>
</section>
