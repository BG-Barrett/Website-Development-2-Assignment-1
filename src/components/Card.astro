---
const { El = "div", TitleLevel = "h2", title, theme = "default" } = Astro.props;
---

<El class="card" data-type={theme}>
  {title && (
    <TitleLevel class="card__heading padding-block-end-2">{title}</TitleLevel>
  )}
  <slot />
</El>

<style lang="scss">
  @use "../styles/abstracts" as *;

  .card {
    align-content: start;
    display: flex;
    flex-wrap: wrap;
    gap: 1rem;
    gap: $card-flow-spacing;
    padding: $card-padding;
    background-color: $card-background-color;
    font-family: $card-font-family;
    color: $card-color-default;
    outline: $card-outline;
    line-height: $card-line-height;
    box-shadow: $card-shadow;
    border-radius: $card-border-radius;

    & > * {
      flex: 1 1 300px;
    }

    &__heading {
      @include heading($card-heading-font-size, $card-heading-color-default);
    }

    &[data-type="review"] {
    }
  }
</style>
