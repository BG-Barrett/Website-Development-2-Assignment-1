---
// footer shown on every page
import LogoLink from "./LogoLink.astro";
// gets the current year when the site is built
const year = new Date().getFullYear();
---

<footer class="site-footer">
  <div class="site-footer__inner container">
    <div class="site-footer__top">
      <div class="site-footer__brand flow">
        <LogoLink />
        <p>Help us help the world</p>
      </div>

      <!-- footer links -->
      <nav aria-label="footer">
        <ul class="site-footer__links flex-group" role="list">
          <li>
            <a href="/">Home</a>
          </li>
          <li>
            <a href="/animals">Animals</a>
          </li>
          <li>
            <a href="/about">About</a>
          </li>
        </ul>
      </nav>
    </div>

    <p class="site-footer__copyright">
      &copy; {year} Wild Welfare. All rights reserved.
    </p>
  </div>
</footer>

<style lang="scss">
  @use "../styles/abstracts" as *;

  .site-footer {
    background-color: $footer-background-color;
    color: $footer-text-color;
    padding-block: $size-12 $size-8;

    // footer link styles, using the footer tokens
    a {
      color: $footer-link-color;
      text-decoration: $footer-link-text-decoration;
      font-family: $footer-link-font-family;

      &:is(:hover, :focus) {
        color: $footer-link-color-hover;
      }
    }

    // spaces out the top row and the copyright line
    &__inner {
      display: grid;
      gap: $size-10;
    }

    // stacked on small screens, side by side on medium screens and up
    &__top {
      display: grid;
      gap: $size-8;

      @include mq(medium) {
        grid-template-columns: 1fr auto;
        align-items: start;
      }
    }

    &__links {
      list-style: none;
    }

    // smaller text with a line above it
    &__copyright {
      font-size: $font-size-300;
      padding-block-start: $size-6;
      border-block-start: 1px solid currentColor;
    }
  }
</style>
