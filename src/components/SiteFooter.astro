---
import LogoLink from "./LogoLink.astro";
---

<footer class="site-footer">
  <div class="site-footer__inner container">
    <div class="site-footer__top">
      <div class="site-footer__brand flow">
        <LogoLink />
        <p>Help us help the world</p>
      </div>

      <nav aria-label="footer">
        <ul class="site-footer__links flex-group" role="list">
          <li>
            <a href="/">Home</a>
          </li>
          <li>
            <a href="/animals">Animals</a>
          </li>
          <li>
            <a href="/about">About</a>
          </li>
        </ul>
      </nav>
    </div>

    <p class="site-footer__copyright">
      &copy; <span id="footer-year"></span> Wild Welfare. All rights reserved.
    </p>
  </div>
</footer>

<script>
  // shows the current year in the footer
  const yearElement = document.querySelector("#footer-year");

  if (yearElement) {
    yearElement.textContent = String(new Date().getFullYear());
  }
</script>

<style lang="scss">
  @use "../styles/abstracts" as *;

  .site-footer {
    background-color: $footer-background-color;
    color: $footer-text-color;
    padding-block: $size-12 $size-8;

    a {
      color: $footer-link-color;
      text-decoration: $footer-link-text-decoration;
      font-family: $footer-link-font-family;

      &:is(:hover, :focus) {
        color: $footer-link-color-hover;
      }
    }

    &__inner {
      display: grid;
      gap: $size-10;
    }

    &__top {
      display: grid;
      gap: $size-8;

      @include mq(medium) {
        grid-template-columns: 1fr auto;
        align-items: start;
      }
    }

    &__links {
      list-style: none;
    }

    &__copyright {
      font-size: $font-size-300;
      padding-block-start: $size-6;
      border-block-start: 1px solid currentColor;
    }
  }
</style>
