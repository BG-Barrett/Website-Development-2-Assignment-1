---
// panel with an image beside a form
import Form from "../components/Form.astro";
import type { ComponentProps } from "astro/types";

// the values this component accepts
interface Props {
  theme?: "primary" | "centered";
  src: string;
  alt: string;
  show?: ComponentProps<typeof Form>["show"];
  buttonText?: string;
  idPrefix?: string;
}

// reads the values passed in, using primary as the default theme
const { theme = "primary", src, alt, show, buttonText, idPrefix } = Astro.props;
---

<div class="cta-panel even-columns" data-type={theme}>
  <img class="cta-panel__image" {src} {alt} />

  <Form show={show} buttonText={buttonText} idPrefix={idPrefix} />
</div>

<style lang="scss">
  @use "../styles/abstracts/" as *;

  .cta-panel {
    padding: $size-10;
    --grid-gap: #{$size-10};
    border: $cta-panel-border;
    border-radius: $cta-panel-border-radius;
    // keeps the image the same shape without stretching it
    &__image {
      width: 100%;
      aspect-ratio: 2 / 1;
      object-fit: cover;
      border-radius: $border-radius-2;
    }

    &[data-type="primary"] {
      background-color: $cta-panel-primary-background-color;
    }

    &[data-type="centered"] {
    }
  }
</style>
