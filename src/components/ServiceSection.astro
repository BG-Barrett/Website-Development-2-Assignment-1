---
// Our Work section on the home page
import Card from "../components/Card.astro";

// the content for each card
const services = [
  {
    title: "Rescue",
    text: "We respond to reports of injured, orphaned and displaced animals. Our team brings each animal safely into our care and gives it a full health check on arrival.",
    image: "/images/alexas_fotos-giraffe-3344366_1920.jpg",
    alt: "Close-up of a giraffe's face looking straight at the camera against blurred trees.",
  },
  {
    title: "Rehabilitation",
    text: "Every animal gets the treatment, food and space it needs to recover. We monitor its progress closely and help it build the strength and instincts to live independently.",
    image: "/images/publicdomainpictures-lions-21787_1920.jpg",
    alt: "Two lionesses beside a weathered tree trunk, one standing on a log and staring at the camera.",
  },
  {
    title: "Release",
    text: "When an animal is ready, we return it to a safe, suitable habitat. We then follow its progress where we can, so each release helps us improve our work.",
    image: "/images/olivier_d-elephants-6254556_1920.jpg",
    alt: "Two tusked elephants facing each other with their trunks raised and touching among green bushes.",
  },
];
---

<section class="services section">
  <div class="services__content container text-center">
    <h2 class="heading-2 padding-block-end-10">Our Work</h2>

    <!-- creates a card for each service -->
    <ul class="services__cards grid-auto-fit" role="list">
      {services.map((service) => (
        <Card El="li" TitleLevel="h3" title={service.title}>
          <img class="services__image" src={service.image} alt={service.alt} />
          <p>{service.text}</p>
        </Card>
      ))}
    </ul>
  </div>
</section>

<style lang="scss">
  @use "../styles/abstracts" as *;

  .services {
    &__image {
      border-radius: $services-image-border-radius;
      object-fit: fill;
      aspect-ratio: 3 / 2;
    }
  }
</style>
