---
import Layout from "../layouts/BaseLayout.astro";
import Button from "../components/Button.astro";
---

<Layout title="Wild Welfare | About">
  <section class="section">
    <div class="container">
      <h1 class="heading-2 padding-block-end-10">About</h1>

      <!-- two sections side by side -->
      <div class="about__layout">
        <!-- filled in by the script using about.json -->
        <div class="about__section">
          <h2 class="about__heading">About me</h2>
          <div id="creator"></div>
        </div>

        <!-- filled in by the script using about.json and animals.json -->
        <div class="about__section">
          <h2 class="about__heading">About the data</h2>
          <p id="background"></p>
          <ul id="stats"></ul>
        </div>
      </div>

      <!-- the credits stay hidden until the button is clicked -->
      <h2 class="about__heading">Image credits</h2>
      <div id="credits-toggle">
        <Button theme="primary">Show image credits</Button>
      </div>
      <ul id="credits" hidden></ul>
    </div>
  </section>

  <!-- javascript -->
  <script>
    import about from "../data/about.json";
    import animals from "../data/animals.json";

    // element selectors
    const creator = document.querySelector("#creator");
    const background = document.querySelector("#background");
    const stats = document.querySelector("#stats");
    const creditsList = document.querySelector<HTMLUListElement>("#credits");
    const creditsButton = document.querySelector("#credits-toggle button");

    // stops the script if an element is missing
    if (!creator || !background || !stats || !creditsList || !creditsButton) {
      throw new Error("A page element is missing");
    }

    // copies these properties from the creator object into variables
    const { name, course, college, startDate, bio } = about.creator;

    // takes the first letter of each word in the name
    const initials = name
      .split(" ")
      .map((word) => word[0].toUpperCase())
      .join("");

    // works out how many full days have passed since the start date
    const msPerDay = 1000 * 60 * 60 * 24;
    const daysSinceStart = Math.floor(
      (Date.now() - new Date(startDate).getTime()) / msPerDay,
    );

    // creates the about me elements
    const creatorName = document.createElement("h3");
    creatorName.textContent = `${name} (${initials})`;

    const creatorCourse = document.createElement("p");
    creatorCourse.textContent = `${course} at ${college}, started ${daysSinceStart} days ago`;

    const creatorBio = document.createElement("p");
    creatorBio.textContent = bio;

    // adds the about me elements to the page
    creator.append(creatorName, creatorCourse, creatorBio);

    // shows the background text about the data
    background.textContent = about.background;

    // creates an array of just the ages
    const ages = animals.map((animal) => animal.age);
    // adds all the ages together
    const totalAge = ages.reduce((total, age) => total + age, 0);
    // rounds the average to a whole number
    const averageAge = Math.round(totalAge / animals.length);
    // finds the highest age
    const oldestAge = Math.max(...ages);
    // finds the animal with the highest age
    const oldest = animals.find((animal) => animal.age === oldestAge);
    // Set removes duplicates, so size is the number of different species
    const speciesCount = new Set(animals.map((animal) => animal.species)).size;
    // counts the animals that are in care
    const inCare = animals.filter(
      (animal) => animal.status === "In care",
    ).length;

    // the text for each stat
    const statLines = [
      `${animals.length} animals across ${speciesCount} species`,
      `Average age: ${averageAge}`,
      `Oldest: ${oldest?.name}, aged ${oldestAge}`,
      `Currently in care: ${inCare}`,
    ];

    // adds a list item to the page for each stat
    statLines.forEach((line) => {
      const item = document.createElement("li");
      item.textContent = line;
      stats.append(item);
    });

    // adds a list item to the page for each image credit
    about.credits.forEach((credit) => {
      const item = document.createElement("li");
      item.textContent = `${credit.subject} by ${credit.photographer}`;
      creditsList.append(item);
    });

    // shows or hides the credits on click and updates the button text
    creditsButton.addEventListener("click", () => {
      creditsList.hidden = !creditsList.hidden;
      creditsButton.textContent = creditsList.hidden
        ? "Show image credits"
        : "Hide image credits";
    });
  </script>
</Layout>

<style lang="scss" is:global>
  @use "../styles/abstracts" as *;

  .about {
    // lets the sections sit side by side and wrap on small screens
    &__layout {
      display: flex;
      flex-wrap: wrap;
      gap: $size-8;
      margin-block-end: $size-8;
    }

    // each section starts at 20rem wide and shares any spare space
    &__section {
      flex: 1 1 20rem;
    }

    // section heading style
    &__heading {
      @include heading($font-size-500);
    }
  }
</style>
